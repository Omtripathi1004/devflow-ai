# DevFlow AI - Environment Configuration Template

# Adapter Mode: 'simulation' or 'live'
BOB_ADAPTER_MODE=simulation

# IBM Bob 2.0 REST Gateway Configuration (used when BOB_ADAPTER_MODE=live)
BOB_API_ENDPOINT=https://api.ibm.com/bob/v2/orchestrate
BOB_API_KEY=your_ibm_bob_api_key_here
BOB_MODEL_ID=ibm-granite-3-code-34b

# Orchestrator Settings
ENABLE_HUMAN_IN_THE_LOOP=true
DEFAULT_SIMULATION_SPEED=2x # options: '1x', '2x', 'instant'

# Deployment Target
CANARY_DEPLOY_TARGET=canary.internal.cluster.local
